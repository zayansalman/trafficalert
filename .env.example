GEMINI_API_KEY=
# Optional. Defaults to gemini-3.5-flash-lite if unset.
GEMINI_MODEL=

# Optional. Routing and geocoding run on free public OpenStreetMap services by default and
# need no key. Both public instances are shared, best-effort and rate-limited — set these to
# your own instances before putting real traffic through them.
# Defaults to https://router.project-osrm.org
OSRM_BASE_URL=
# Defaults to https://nominatim.openstreetmap.org
NOMINATIM_BASE_URL=
