GEMINI_API_KEY=
# Optional. Defaults to gemini-3.5-flash-lite if unset.
GEMINI_MODEL=

# Fallback provider, used when Gemini fails or is out of quota.
HF_API_KEY=
# Optional. Defaults to openai/gpt-oss-120b if unset.
HF_MODEL=

# Turso (libsql) — production storage for user-submitted reports.
TURSO_DATABASE_URL=libsql://<db-name>-<org>.turso.io
TURSO_AUTH_TOKEN=
